<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Login | Store</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --brand-primary: #ff5722;
            --brand-dark: #1e293b;
            --bg-light: #f8fafc;
        }

        body {
            background-color: var(--bg-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
        }

        .auth-card {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
        }

        .brand-badge {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: rgba(255, 87, 34, 0.1);
            color: var(--brand-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .form-control {
            border-color: #cbd5e1;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            border-radius: 8px;
            transition: all 0.2s ease-in-out;
        }

        .form-control:focus {
            border-color: var(--brand-primary);
            box-shadow: 0 0 0 4px rgba(255, 87, 34, 0.15);
        }

        .btn-ecommerce {
            background-color: var(--brand-primary);
            border-color: var(--brand-primary);
            color: #ffffff;
            padding: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-ecommerce:hover {
            background-color: #e64a19;
            border-color: #e64a19;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .forgot-link {
            color: #64748b;
            font-size: 0.875rem;
            text-decoration: none;
            transition: color 0.15s ease-in-out;
        }

        .forgot-link:hover {
            color: var(--brand-primary);
            text-decoration: underline;
        }

        .trust-badge {
            font-size: 0.75rem;
            color: #94a3b8;
        }
    </style>
</head>
<body class="d-flex flex-column justify-content-between">

    <!-- Minimal E-Commerce Header -->
    <header class="py-3 px-4 border-bottom bg-white">
        <div class="container d-flex align-items-center justify-content-between">
            <span class="fw-bold fs-5 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-bag-check-fill text-warning"></i> STORE
            </span>
            <span class="text-muted small">Need help? <a href="#" class="text-decoration-none">Contact Support</a></span>
        </div>
    </header>

    <!-- Main Login Container -->
    <main class="container my-auto py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-9 col-md-7 col-lg-5 col-xl-4">
                
                <div class="card auth-card p-4 p-md-5">
                    
                    <div class="text-center mb-4">
                        <div class="brand-badge mb-3">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <h1 class="h4 fw-bold text-dark mb-1 text-capitalize">login page</h1>
                        <p class="text-muted small mb-0">Access your orders, wishlist, and cart</p>
                    </div>

                    <!-- Untouched Form Fields & Attributes -->
                    <form action="/login" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Email address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="text" name="email" placeholder="email" class="form-control border-start-0 ps-0">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-shield-lock"></i>
                                </span>
                                <input type="password" name="password" placeholder="password" class="form-control border-start-0 ps-0">
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mb-4">
                            <!-- Preserved Link -->
                            <a href="/forgotPassword" class="forgot-link">forgot password</a>
                        </div>

                        <div class="d-grid mb-3">
                            <!-- Preserved Button -->
                            <button type="submit" class="btn btn-ecommerce text-capitalize">login</button>
                        </div>

                    </form>

                    <!-- E-commerce Trust Badges -->
                    <div class="text-center pt-3 border-top mt-3">
                        <p class="trust-badge mb-0 d-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-lock-fill"></i> End-to-end 256-bit encrypted checkout
                        </p>
                    </div>

                </div>

            </div>
        </div>
    </main>

 
    <footer class="py-3 bg-white border-top text-center text-muted small">
        <div class="container">
            &copy; 2026 YourStore, Inc. All rights reserved.
        </div>
    </footer>

   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>