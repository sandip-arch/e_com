<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payment</title>

    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" 
    >

    <style>
        body {
            background: #f5f7fa;
        }

        .payment-container {
            max-width: 900px;
            margin: 50px auto;
        }

        .payment-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .payment-method {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: 0.2s;
        }

        .payment-method:hover {
            border-color: #0d6efd;
            background: #f8fbff;
        }

        .payment-method input {
            margin-right: 10px;
        }

        .amount {
            font-size: 28px;
            font-weight: bold;
        }

        .transaction {
            font-size: 13px;
            color: #666;
            word-break: break-all;
        }
    </style>
</head>


<body>

    <div class="container payment-container" id="paymentForm">

        <div class="row g-4">

            <!-- Payment Details -->

            <div class="col-md-7">

                <div class="card payment-card">

                    <div class="card-body p-4">

                        <h3 class="mb-4">
                            Complete Payment
                        </h3>


                        <!-- Product -->

                        <div class="mb-4">

                            <h5>Order Details</h5>

                            <div class="d-flex justify-content-between">

                                <span>
                                    <%= payment.productId.name %>
                                </span>

                                <span>
                                    ₹<%= payment.productId.price %>
                                </span>

                            </div>


                            <div class="d-flex justify-content-between text-muted">

                                <span>
                                    Quantity
                                </span>

                                <span>
                                    <%= payment.quantity %>
                                </span>

                            </div>

                        </div>


                        <hr>


                        <!-- Payment Methods -->

                        <h5 class="mb-3">
                            Select Payment Method
                        </h5>


                        <label class="payment-method d-block">

                            <input type="radio" name="paymentMethod" value="UPI">

                            <strong>UPI</strong>

                            <div class="text-muted small">
                                Pay using UPI
                            </div>

                        </label>


                        <label class="payment-method d-block">

                            <input type="radio" name="paymentMethod" value="CARD">

                            <strong>Credit / Debit Card</strong>

                            <div class="text-muted small">
                                Visa, Mastercard, RuPay
                            </div>

                        </label>


                        <label class="payment-method d-block">

                            <input type="radio" name="paymentMethod" value="NET_BANKING">

                            <strong>Net Banking</strong>

                            <div class="text-muted small">
                                Pay using your bank account
                            </div>

                        </label>


                        <label class="payment-method d-block">

                            <input type="radio" name="paymentMethod" value="WALLET">

                            <strong>Wallet</strong>

                            <div class="text-muted small">
                                Pay using wallet
                            </div>

                        </label>


                        <button type="button" id="payButton" class="btn btn-primary w-100 mt-3">
                            Pay ₹<%= payment.amount.toFixed(2) %>
                        </button>

                    </div>

                </div>

            </div>


            <!-- Order Summary -->

            <div class="col-md-5">

                <div class="card payment-card">

                    <div class="card-body p-4">

                        <h5 class="mb-4">
                            Payment Summary
                        </h5>


                        <div class="d-flex justify-content-between mb-2">

                            <span>
                                Product
                            </span>

                            <span>
                                ₹<%= ( payment.productId.price * payment.quantity ).toFixed(2) %>
                            </span>

                        </div>


                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Delivery
                            </span>

                            <span>
                                ₹<%= ( payment.amount - ( payment.productId.price * payment.quantity ) ).toFixed(2) %>
                            </span>

                        </div>


                        <hr>


                        <div class="d-flex justify-content-between align-items-center">

                            <strong>
                                Total
                            </strong>

                            <span class="amount">
                                ₹<%= payment.amount.toFixed(2) %>
                            </span>

                        </div>


                        <hr>


                        <div class="mt-3">

                            <div class="transaction">
                                Transaction ID
                            </div>

                            <div class="transaction">
                                <%= payment.transactionId %>
                            </div>

                        </div>


                        <div class="mt-3">

                            <div class="transaction">
                                Payment Session
                            </div>

                            <div class="transaction">
                                <%= payment.sessionId %>
                            </div>

                        </div>


                        <div class="mt-3">

                            <span class="badge bg-secondary">
                                <%= payment.status %>
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <div id="paymentSuccess" class="container text-center py-5" style="display: none;">

        <div class="card shadow-sm p-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>

            <h2 class="text-success mt-3">Payment Successful!</h2>

            <p>Your payment has been completed successfully.</p>

            <p>
                Transaction ID:
                <strong id="successTransactionId"></strong>
            </p>

            <a href="/" class="btn btn-primary mt-3">
                <i class="bi bi-house-door me-2"></i>
                Back to Homepage
            </a>
        </div>
    </div>


    <script>

        const payButton =
            document.getElementById('payButton');


        payButton.addEventListener('click', async () => {


            const selectedMethod =
                document.querySelector(
                    'input[name="paymentMethod"]:checked'
                );


            if (!selectedMethod) {

                alert(
                    'Please select a payment method.'
                );

                return;
            }


            const paymentMethod =
                selectedMethod.value;

            const sessionId =
                '<%= payment.sessionId %>';


            payButton.disabled = true;

            payButton.innerHTML =
                'Processing Payment...';


            try {

                const response = await fetch(
                    '/payment/process',
                    {

                        method: 'POST',

                        credentials: 'same-origin',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body: JSON.stringify({

                            sessionId:
                                sessionId,

                            paymentMethod:
                                paymentMethod

                        })

                    }
                );
                const contentType =
                    response.headers.get('content-type') || '';

                if (!contentType.includes('application/json')) {

                    const html = await response.text();

                    console.error(
                        'Server returned HTML instead of JSON:',
                        html
                    );

                    throw new Error(
                        'Server did not return a JSON response. Check authentication or payment route.'
                    );
                }

                const data = await response.json();


                console.log(
                    'Payment response:',
                    data
                );

                if (
                    !response.ok ||
                    !data.success
                ) {

                    throw new Error(
                        data.message ||
                        'Payment failed'
                    );

                }

                document.getElementById('successTransactionId').textContent =
                    data.payment.transactionId;

                // Hide payment details and show success message
                const paymentForm = document.getElementById('paymentForm');
                const paymentSuccess = document.getElementById('paymentSuccess');

                if (paymentForm && paymentSuccess) {
                    paymentForm.style.display = 'none';
                    paymentSuccess.style.display = 'block';
                }


            } catch (error) {

                console.error(
                    'Payment processing error:',
                    error
                );


                alert(
                    error.message ||
                    'Payment failed'
                );


                payButton.disabled = false;

                payButton.innerHTML =
                    'Pay ₹<%= payment.amount.toFixed(2) %>';

            }

        });

    </script>

</body>

</html>