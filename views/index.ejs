                                <a href="#products" class="btn btn-brand-primary btn-lg px-4 me-2">Explore Audio</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- slide 3 -->
                <div class="carousel-item hero-carousel-item"
                    style="background-image: url('https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=1500&q=80');">
                    <div class="carousel-overlay">
                        <div class="container">
                            <div class="col-lg-6 text-white">
                                <span class="badge bg-info text-dark mb-2 px-3 py-2 fw-semibold">New Arrival</span>
