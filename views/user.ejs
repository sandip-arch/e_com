<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <!-- Bootstrap 5 CSS & Icons (required for the layout & cart icon) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>

<body>
    <div class="container my-4">
        <h1>Dashboard</h1>
        <p class="lead">Hello, <%= user.role %>!</p>

        <% if (user.role==='admin' ) { %>
            <h2>Welcome, Admin</h2>
            <p>Admin panel overview and system stats go here.</p>

            <% } else if (user.role==='distributor' ) { %>
                <h2>Welcome, Distributor</h2>
                <a href="/product/addProduct" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle me-1"></i> Add Product
                </a>

                <% } else if (user.role==='user' ) { %>
                    <h2>Welcome, <%= user.name || 'User' %>
                    </h2>

                    <main class="container my-5" id="products">
                        <div class="d-flex justify-content-between align-items-end mb-4">
                            <div>
                                <span class="text-uppercase text-muted fw-bold small">Explore Catalog</span>
                                <h2 class="h3 fw-bold text-dark mb-0">Featured Products</h2>
                            </div>
                        </div>

                        <div class="row g-4">
                            <% if (products && products.length> 0) { %>
                                <% products.forEach(product=> { %>
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <div class="card h-100 shadow-sm d-flex flex-column">

                                            <!-- Product Image & Quantity Status Badge -->
                                            <div class="position-relative text-center bg-light"
                                                style="height: 220px; overflow: hidden;">
                                                <% if (product.quantity <=0) { %>
                                                    <span
                                                        class="badge bg-danger position-absolute top-0 start-0 m-2">Out
                                                        of Stock</span>
                                                    <% } else if (product.quantity <=5) { %>
                                                        <span
                                                            class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">Only
                                                            <%= product.quantity %> left!
                                                        </span>
                                                        <% } %>

                                                            <img src="<%= product.image || 'https://via.placeholder.com/300x200?text=No+Image' %>"
                                                                alt="<%= product.name %>"
                                                                class="w-100 h-100 object-fit-cover">
                                            </div>

                                            <!-- Card Details -->
                                            <div class="card-body d-flex flex-column flex-grow-1">
                                                <!-- Category / Type -->
                                                <div class="text-uppercase text-muted small fw-semibold mb-1">
                                                    <%= product.type %>
                                                </div>

                                                <!-- Product Name -->
                                                <h3 class="h6 fw-bold text-dark mb-1 text-truncate"
                                                    title="<%= product.name %>">
                                                    <%= product.name %>
                                                </h3>

                                                <!-- Description -->
                                                <% if (product.description) { %>
                                                    <p class="text-muted small mb-2 text-truncate"
                                                        title="<%= product.description %>">
                                                        <%= product.description %>
                                                    </p>
                                                    <% } %>

                                                        <!-- Price -->
                                                        <div class="mb-3 mt-auto">
                                                            <span class="fs-5 fw-bold text-dark">$<%=
                                                                    Number(product.price).toFixed(2) %></span>
                                                        </div>

                                                        <!-- Action Buttons -->
                                                        <div class="d-grid gap-2">
                                                            <% if (product.quantity> 0) { %>
                                                                <form action="/cart/add" method="POST">
                                                                    <input type="hidden" name="productId"
                                                                        value="<%= product._id %>">
                                                                    <button type="submit"
                                                                        class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-2">
                                                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                                                    </button>
                                                                </form>
                                                                <a href="/checkout/<%= product._id %>"
                                                                    class="btn btn-brand-primary text-decoration-none text-center">
                                                                    Buy Now
                                                                </a>
                                                                <% } else { %>
                                                                    <button class="btn btn-secondary"
                                                                        disabled>Unavailable</button>
                                                                    <% } %>
                                                        </div>
                                            </div>

                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="col-12">
                                                <div class="alert alert-info" role="alert">
                                                    No products found. Check back later!
                                                </div>
                                            </div>
                                            <% } %>
                        </div>
                    </main>
                    <% } %>
    </div>
</body>

</html>